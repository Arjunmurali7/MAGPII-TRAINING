@model IEnumerable<task7.Models.Employee>

<h2>Employees List</h2>
<a href="/Employees/Create">Add Employee</a>
<table border="1">
    <tr><th>Name</th><th>Email</th><th>Department</th></tr>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Name</td>
            <td>@e.Email</td>
            <td>@e.Department</td>
        </tr>
    }
</table>
